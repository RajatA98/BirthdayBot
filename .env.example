# =============================================================================
# BirthdayBot env template
# =============================================================================
# Copy to `.env` and fill in. `.env` is gitignored.
#
# Format: KEY=value (no quotes needed; no spaces around =).
# Lines starting with `#` and blank lines are ignored.
#
# Verify all providers are reachable after filling this in:
#   npx tsx scripts/api-check.ts
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED — without these, the core flow won't run
# -----------------------------------------------------------------------------

# OpenAI — photo vision + plan/caption generation.
# https://platform.openai.com/api-keys
# If absent: planBirthdayVideo + analyzePhoto fall back to mock data, so the
# UI still works for dev but plans are canned.
OPENAI_API_KEY=

# fal.ai — kling photo-to-video generation. Required, no fallback (the stock-
# demo fallback was removed). 403 with "User is locked. Reason: Exhausted
# balance" means top up at https://fal.ai/dashboard/billing.
# https://fal.ai/dashboard/keys
FAL_KEY=

# ElevenLabs — voice cloning (IVC), TTS, speech-to-speech, AI music bed.
# If absent: voice cloning + AI music quietly skip, the mux falls back to
# the local static party-music.mp3 (or a lavfi tone if even that's missing),
# and the result MP4 has no voice-over.
# https://elevenlabs.io/app/settings/api-keys
# `XI_API_KEY` is accepted as an alias for backward compat.
ELEVENLABS_API_KEY=


# -----------------------------------------------------------------------------
# OPTIONAL — model & endpoint overrides (sane defaults already in code)
# -----------------------------------------------------------------------------

# Override the fal video model. Default below; keep it unless intentionally
# testing a different endpoint (other endpoints have different schemas).
FAL_VIDEO_MODEL=fal-ai/kling-video/v3/standard/image-to-video

# Hard cap on the fal prompt length. Live limit is 2500; we cap at 2400 to
# leave headroom. Drop to 512 if you hit a stricter endpoint.
# FAL_PROMPT_CHAR_LIMIT=2400

# Override the OpenAI model used by the planner. gpt-4.1-mini is the default
# (fast + cheap + good enough). Use gpt-4o for higher quality at higher cost.
OPENAI_PLAN_MODEL=gpt-4.1-mini

# Override the ElevenLabs text-to-speech model. eleven_v3 is the most
# expressive (supports inline audio tags like [warmly] / [excited]).
# eleven_multilingual_v2 is faster if you're latency-sensitive.
ELEVENLABS_TTS_MODEL=eleven_v3

# Override the ElevenLabs speech-to-speech model used for the "speak-yourself"
# voice mode. Default is eleven_multilingual_sts_v2.
# ELEVENLABS_STS_MODEL=eleven_multilingual_sts_v2

# Force a specific stock voice ID for the narration fallback. If unset, the
# code picks one based on the agent plan's `narrationVoiceCue` (e.g. a
# warm Latin-leaning voice for mariachi cues). Set this to override.
# ELEVENLABS_STOCK_VOICE_ID=21m00Tcm4TlvDq8ikWAM


# -----------------------------------------------------------------------------
# OPTIONAL — cultural-accent voice slots
# -----------------------------------------------------------------------------
# The default ElevenLabs voice catalog is English-American. For authentic
# non-English accents, add voices from the EL voice library to your account
# and paste their voice_ids below. When unset, the code falls through to
# the English-American default.

# ELEVENLABS_VOICE_SPANISH=
# ELEVENLABS_VOICE_INDIAN=
# ELEVENLABS_VOICE_KOREAN=
# ELEVENLABS_VOICE_JAPANESE=
# ELEVENLABS_VOICE_AFRICAN=
# ELEVENLABS_VOICE_ARABIC=
# ELEVENLABS_VOICE_MANDARIN=
# ELEVENLABS_VOICE_BRITISH=
# ELEVENLABS_VOICE_AUSTRALIAN=


# -----------------------------------------------------------------------------
# OPTIONAL — music mode
# -----------------------------------------------------------------------------

# Force the AI music bed on or off. If unset, AI music is auto-enabled when
# ELEVENLABS_API_KEY is present, with safe fallback to public/audio/party-music.mp3.
# Set "true" / "false" explicitly to override.
# USE_AI_MUSIC=


# -----------------------------------------------------------------------------
# OPTIONAL — observability (Langfuse)
# -----------------------------------------------------------------------------
# Recommended in real-photo testing — traces prompt decisions, retries,
# timings, and provider outcomes per request.
# https://us.cloud.langfuse.com (or self-hosted)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com


# -----------------------------------------------------------------------------
# OPTIONAL — email delivery (send postcard via Resend)
# -----------------------------------------------------------------------------
# Used by the email-send flow on the result screen. If absent, the email
# button is hidden and download is the only share path.
# https://resend.com/api-keys

# RESEND_API_KEY=
# EMAIL_FROM=postcard@yourdomain.com
# BIRTHDAYBOT_EMAIL_FROM=postcard@yourdomain.com
# BIRTHDAYBOT_PUBLIC_URL=https://yourdomain.com
